{
  "name": "luma-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "Luma Clinic — aesthetic, laser and skincare clinic management (demo build)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/db/reset.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "express": "^5.3.0",
    "lucide-react": "^0.511.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "playwright-core": "^1.64.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.5"
  }
}
